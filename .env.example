# ====================
# DashScope API (LLM + Embedding + Rerank)
# ====================
OPENAI_API_KEY=sk-your-dashscope-api-key-here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen3-vl-flash
ITEM_MODEL=qwen-flash

# ====================
# Embedding
# ====================
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Rerank
# ====================
RERANK_MODEL=gte-rerank-v2

# ====================
# Milvus
# ====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# MongoDB
# ====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb001

# ====================
# MinIO
# ====================
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=images
MINIO_EXTERNAL_ENDPOINT=your-minio-host:9002

# ====================
# Other
# ====================
MD_ROOT_DIR=./temp-files/
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MODEL=qwen-flash

# ====================
# Mineru API
# ====================
MINERU_API_TOKEN=your-mineru-token-here
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# 数据导入根目录
# ====================
DATA_BASED_ROOT_DIR=/path/to/your/project/output/import